# Default model alias from config/models.conf.
MODEL_NAME=llama3-8b

# Port used by the inference server.
PORT=11434

# OpenAI-compatible backend base URL.
LLM_BACKEND_URL=http://localhost:11434/v1

# Optional token for gated HuggingFace models used by vLLM.
HF_TOKEN=

# Optional API key expected by api/proxy.py. Leave blank to disable auth.
PROXY_API_KEY=

# Port used by `make proxy`.
PROXY_PORT=8081
